# Maintainer: basihamam <basihamam@users.noreply.github.com>
pkgname=arch-explorer-bin
_pkgname=arch-explorer
pkgver=0.1.0
pkgrel=1
pkgdesc="Modern tabbed file manager for Arch Linux with ADB & dual-pane support"
arch=('x86_64')
url="https://github.com/basihamam/arch-explorer-tauri"
license=('GPL3')
depends=('gtk3' 'webkit2gtk-4.1' 'android-tools')
optdepends=(
    'ffmpeg: Video thumbnail generation and faststart streaming'
    'trash-cli: Trash restore support'
    'gvfs: Optional removable media integration'
)
provides=('arch-explorer')
conflicts=('arch-explorer')
source=("https://github.com/basihamam/arch-explorer-tauri/releases/download/v${pkgver}/arch-explorer-v${pkgver}-x86_64.tar.gz")
sha256sums=('21990d21462e0dd4abd846379a2dff6184b4320f94d5628e95d6994230f9aa33')

package() {
    install -Dm755 "${srcdir}/arch-explorer" "${pkgdir}/usr/bin/arch-explorer"
    install -Dm644 "${srcdir}/arch-explorer.desktop" "${pkgdir}/usr/share/applications/arch-explorer.desktop"
    install -Dm644 "${srcdir}/arch-explorer.png" "${pkgdir}/usr/share/icons/hicolor/128x128/apps/arch-explorer.png"
}
