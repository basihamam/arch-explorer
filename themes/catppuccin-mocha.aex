[meta]
name        = "Catppuccin Mocha"
author      = "catppuccin"
version     = "1.0.0"
description = "Soothing pastel theme"

[colors]
bg_base      = "#1e1e2e"
bg_mantle    = "#181825"
bg_crust     = "#11111b"
bg_surface0  = "#313244"
bg_surface1  = "#45475a"
bg_surface2  = "#585b70"
accent       = "#cba6f7"
accent_dim   = "#9874c9"
accent_glow  = "#cba6f730"
text_primary   = "#cdd6f4"
text_secondary = "#bac2de"
text_hint      = "#6c7086"
text_disabled  = "#45475a"
success = "#a6e3a1"
warning = "#f9e2af"
danger  = "#f38ba8"
info    = "#89dceb"
border       = "#45475a"
border_focus = "#cba6f7"
