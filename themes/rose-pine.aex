bg_surface1  = "#403d52"
bg_surface2  = "#524f67"
accent       = "#c4a7e7"
accent_dim   = "#9678bf"
accent_glow  = "#c4a7e730"
text_primary   = "#e0def4"
text_secondary = "#908caa"
