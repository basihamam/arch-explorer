[meta]
name        = "Nord"
author      = "arcticicestudio"
version     = "1.0.0"
description = "An arctic, north-bluish color palette"

[colors]
bg_base      = "#2e3440"
bg_mantle    = "#242933"
bg_crust     = "#1c2028"
bg_surface0  = "#3b4252"
bg_surface1  = "#434c5e"
bg_surface2  = "#4c566a"
accent       = "#88c0d0"
accent_dim   = "#5e97ad"
accent_glow  = "#88c0d030"
text_primary   = "#eceff4"
text_secondary = "#d8dee9"
text_hint      = "#616e88"
text_disabled  = "#434c5e"
success = "#a3be8c"
warning = "#ebcb8b"
danger  = "#bf616a"
info    = "#81a1c1"
border       = "#3b4252"
border_focus = "#88c0d0"
